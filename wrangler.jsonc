{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yasumi-kumi",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "yasumi-kumi.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": { "crons": ["46 20 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yasumi-kumi",
      "database_id": "d594b16e-f164-44a9-b0f9-13685993c874",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
